# Development settings for npm run dev (http://localhost:5173).
# Vite loads this as .env.development.local; restart npm run dev after editing.

# Canonical domain for canonical URLs, sitemap and JSON-LD.
# Kept as the live domain so dev pages match production.
VITE_SITE_URL=https://pdcadental.com

# Local qindom base URL (no trailing slash). qindom's npm run dev listens on PORT from its
# .env.dev, or 3000 if PORT isn't set.
# Note: in dev, track() only logs to the browser console and never sends to /analytics/collect.
# This URL is used in dev by the Insights adapter (/analytics/report).
VITE_ANALYTICS_ENDPOINT=http://localhost:3000

# Local qindom enquiry endpoint. Empty = form hidden.
VITE_ENQUIRY_ENDPOINT=http://localhost:3000/pdca/enquiry

# Feature flags (v1.1 pages and sections)
VITE_FEATURE_OUR_WORK=false
VITE_FEATURE_CAREERS=false
VITE_FEATURE_TESTIMONIALS=false

# Insights data adapter: "mock" (default) or "qindom".
# With "qindom", open http://localhost:5173/insights?key=<viewer key>
VITE_ANALYTICS_SOURCE=qindom