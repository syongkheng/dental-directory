# Copy to .env (or .env.local) and adjust.

# Canonical domain for canonical URLs, sitemap and JSON-LD (to be confirmed by PDCA)
VITE_SITE_URL=https://pdcadental.com

# qindom base URL (no trailing slash). After cookie consent, analytics events go to
# <url>/analytics/collect; the qindom Insights adapter reads <url>/analytics/report.
# Empty = tracking off.
VITE_ANALYTICS_ENDPOINT=

# Full URL of the enquiry endpoint (qindom: <qindom-url>/pdca/enquiry). Empty = form hidden.
VITE_ENQUIRY_ENDPOINT=

# Feature flags (v1.1 pages and sections)
VITE_FEATURE_OUR_WORK=false
VITE_FEATURE_CAREERS=false
VITE_FEATURE_TESTIMONIALS=false

# Insights data adapter: "mock" (default) or "qindom"
VITE_ANALYTICS_SOURCE=mock
